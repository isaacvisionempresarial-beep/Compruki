# Copia a .env.local (local) o configura las mismas claves en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_key

# Origen público de la app (sin barra final).
# Local: http://localhost:3010
# Producción (previsto): https://compruki.com
# Mientras tanto puede ser la URL de Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Tras desplegar, en Supabase → Authentication → URL Configuration:
# - Site URL = NEXT_PUBLIC_SITE_URL
# - Redirect URLs = {SITE}/auth/callback  y  {SITE}/ingresar
#
# Dropi: la contraseña solo se escribe en oauth.dropi.co.
# Esta aplicación todavía no tiene client_id. No pegues usuario ni clave aquí.
#
# OpenAI (AG-0 · solo servidor). No uses NEXT_PUBLIC_*.
# Clave de la plataforma API (platform.openai.com), no basta ChatGPT Plus.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# Estimación local de costo por corrida (COP / 1000 tokens). No es la factura de OpenAI.
# OPENAI_COP_PER_1K_TOKENS=200
#
# Readiness: GET /api/health
# - 200 si las 4 vars existen y el tenant tienda-piloto responde en Postgres
# - 503 si falta env o no se puede leer el tenant
# - Público solo responde { ok, service }; el detalle vive en el panel
#
# Rate limit compartido (Railway multi-réplica):
# Ejecutar supabase/migrations/016_public_rate_attempts.sql en SQL Editor.
# Sin esa migración, COMPRUKI cae al contador en memoria del proceso.
#
# Cuentas de comprador:
# Ejecutar supabase/migrations/017_customer_accounts.sql
# Supabase → Authentication → Providers → Google (Client ID/Secret de Google Cloud, gratis).
# Redirect URLs: {SITE}/auth/callback  y  {SITE}/tienda/cuenta
#
# Correos de estado de pedido (opcional):
# RESEND_API_KEY=re_...
# EMAIL_FROM=COMPRUKI <pedidos@tu-dominio.com>
#
# WhatsApp Meta Cloud API (Fase 1 · solo servidor). No uses NEXT_PUBLIC_*.
# Ejecutar supabase/migrations/018_whatsapp_meta.sql en SQL Editor.
# Webhook: {SITE}/api/whatsapp/webhook  · panel: /panel/whatsapp
# META_WA_ACCESS_TOKEN=EAAB...
# META_WA_PHONE_NUMBER_ID=1234567890
# META_WA_WABA_ID=1234567890
# META_WA_VERIFY_TOKEN=elige_un_secreto_largo
# META_WA_APP_SECRET=app_secret_de_meta
# META_WA_APP_ID=2662171164235888
# META_WA_GRAPH_VERSION=v22.0
